{
  "name": "termbridge-web",
  "description": "Web terminal prototype for TermBridge Gate precursor.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn build:cloud",
    "build:local": "vue-tsc --noEmit && vite build",
    "build:cloud": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --cache",
    "lint:fix": "eslint src --fix --fix-type=problem --cache",
    "format": "prettier src --check --ignore-unknown",
    "format:fix": "prettier src --write --ignore-unknown",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "axios": "^1.18.1",
    "pinia": "3.0.4",
    "reka-ui": "2.10.0",
    "vue": "3.5.35",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.6",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-vue": "6.0.7",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-vue": "10.9.2",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "8.0.16",
    "vitest": "4.1.9",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.4"
  }
}
