# TermBridge portable local package preflite runtime profile.
# This file is loaded by termbridge.cmd/termbridge.sh when TERMBRIDGE_ENV=preflite.

# Serve packaged frontend assets with the Agent process.
TERMBRIDGE_LOCAL__STATIC_DIR=web

# Keep packaged runtime state under the user home directory so upgrades can
# replace the install tree without wiping device identity, SQLite, or history.
TERMBRIDGE_RUNTIME__STATE_DIR=~/.termbridge
TERMBRIDGE_LOCAL__DATABASE__SQLITE__PATH=~/.termbridge/agent.db
TERMBRIDGE_LOG__DIR=~/.termbridge/logs

# PrefLite Cloud browser entry and Agent service-to-service target.
TERMBRIDGE_CLOUD__PUBLIC_URL=https://termbridge.preflite.cn
TERMBRIDGE_CLOUD__API_BASE_URL=https://termbridge.preflite.cn/api