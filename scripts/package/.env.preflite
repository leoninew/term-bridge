# TermBridge portable local package preflite runtime profile.
# This file is loaded by start.cmd/start.sh when TERMBRIDGE_ENV=preflite.

# Serve packaged frontend assets with the Agent process.
TERMBRIDGE_LOCAL__STATIC_DIR=web

# PrefLite Cloud browser entry and Agent service-to-service target.
TERMBRIDGE_CLOUD__PUBLIC_URL=https://termbridge.preflite.cn
TERMBRIDGE_CLOUD__API_BASE_URL=https://termbridge.preflite.cn/api
