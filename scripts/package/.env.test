# TermBridge portable local package test runtime profile.
# This file is loaded by start.cmd/start.sh when TERMBRIDGE_ENV=test.

TERMBRIDGE_LOCAL__STATIC_DIR=web
TERMBRIDGE_LOCAL__LISTEN_URL=http://127.0.0.1:9030
TERMBRIDGE_LOCAL__PUBLIC_URL=http://localhost:9030
TERMBRIDGE_LOCAL__API_BASE_PATH=/api
TERMBRIDGE_LOCAL__DATABASE__SQLITE__PATH=data/agent.db

# Test Cloud browser entry and Agent service-to-service target.
TERMBRIDGE_CLOUD__PUBLIC_URL=http://termbridge.lvh.me
TERMBRIDGE_CLOUD__API_BASE_URL=http://termbridge.lvh.me/api

# OAuth client registered on the Cloud backend. Keep client_secret out of web/.env.*.
TERMBRIDGE_LOCAL__OAUTH__CLIENT_ID=termbridge-agent
TERMBRIDGE_LOCAL__OAUTH__CLIENT_SECRET=agent-secret
TERMBRIDGE_LOCAL__OAUTH__REDIRECT_URL=http://localhost:9030/oauth/callback
TERMBRIDGE_LOCAL__OAUTH__SCOPES=openid,email,profile
