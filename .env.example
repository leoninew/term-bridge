# TermBridge-go 环境变量示例
#
# 复制为项目根目录下的 .env 后生效；复制为 .env.<env> 后配合 OS env TERMBRIDGE_ENV=<env> 生效。
# 默认配置优先级：configs/config.yaml < .env < OS env。
# 设置 OS env TERMBRIDGE_ENV=<env> 后，优先级为：
# configs/config.yaml < configs/config.<env>.yaml < .env.<env> < OS env。
# TERMBRIDGE_ENV 只从 OS env 读取，不从 .env / .env.<env> 读取。
# .env / .env.<env> 不会覆盖 Docker/systemd/Kubernetes/CI/shell 已注入的同名环境变量。
# Cloud runtime 必须显式提供 TERMBRIDGE_CLOUD__JWT__SECRET_KEY；Agent runtime 不消费此配置。应用不会在运行时生成或写回该配置。设备身份生成在 runtime.state_dir/device.json。
# 命名规则：TERMBRIDGE_ + 配置 key 大写，key 中的 . 转为 __。

# ==============================================================================
# Build metadata
# ==============================================================================

# 构建元数据仅在调用 task build、task package 或 task docker 的 shell/CI 环境中读取，编译后不可通过运行时配置修改。
# 不属于 configs/config*.yaml 或运行时 .env 的配置项。
# VERSION 默认从 Git release tag、tag 后提交或开发 revision 自动派生；有未提交变更时追加 -dirty。
# 仅在 CI 或源码归档无法读取 Git 元数据时，才显式设置 TERMBRIDGE_BUILD_VERSION。
# COMMIT 固定读取当前 Git HEAD 的 12 位短 hash；BUILD_TIME 默认当前 UTC 时间（YYYYMMDD-HHMMSS）。
# TERMBRIDGE_BUILD_VERSION=v1.2.3
# TERMBRIDGE_BUILD_TIME=20260714-094612

# ==============================================================================
# Log
# ==============================================================================

# TERMBRIDGE_LOG__LEVEL=info
# TERMBRIDGE_LOG__FORMAT=text
# TERMBRIDGE_LOG__DIR=logs
# TERMBRIDGE_LOG__HTTP__ENABLED=false
# TERMBRIDGE_LOG__HTTP__REQUEST_BODY_LIMIT=4096
# TERMBRIDGE_LOG__HTTP__RESPONSE_BODY_LIMIT=4096
# When enabled, successful GET/HEAD under /assets/ (200/304) skip request logs.
# TERMBRIDGE_LOG__HTTP__SKIP_ASSET_ENABLED=true
# 常见前端静态资源扩展名；多值使用逗号分隔。

# ==============================================================================
# Terminal history / replay / client queue
# ==============================================================================

# 历史落盘容量；replay 只控制 attach 时回放体积。
# TERMBRIDGE_TERMINAL__HISTORY__MAX_LINES=2000
# TERMBRIDGE_TERMINAL__HISTORY__MAX_BYTES=1048576
# TERMBRIDGE_TERMINAL__HISTORY__MAX_LINE_BYTES=65536

# attach 时回放最近输出；history 控制落盘容量，replay 只控制回放体积。
# TERMBRIDGE_TERMINAL__REPLAY__MAX_BYTES=262144
# TERMBRIDGE_TERMINAL__REPLAY__CHUNK_BYTES=65536
# TERMBRIDGE_TERMINAL__CLIENT__QUEUE__MAX_MESSAGES=64
# TERMBRIDGE_TERMINAL__CLIENT__QUEUE__MAX_BYTES=4194304

# Browser tab keep-alive (projected to BrowserRuntimeConfig).
# TERMBRIDGE_TERMINAL__KEEPALIVE__MAX_HOT_TERMINALS=4
# TERMBRIDGE_TERMINAL__KEEPALIVE__DISPOSE_DELAY_MS=30000
# TERMBRIDGE_TERMINAL__QUOTA__CONCURRENT_ATTACHES=8

# ==============================================================================
# Runtime
# ==============================================================================

# 开发默认：相对 cwd 的 data；打包环境（.env.preflite）使用 ~/.termbridge。
# ~ 或 ~/... 解析到用户主目录；相对路径仍相对 cwd。
# TERMBRIDGE_RUNTIME__STATE_DIR=data
# TERMBRIDGE_RUNTIME__STATE_DIR=~/.termbridge

# ==============================================================================
# Agent
# ==============================================================================

# termbridge agent 暴露的本机 Web/API 地址。baseline 默认 127.0.0.1:9030；本地联调配置见 configs/config.development.yaml。
# TERMBRIDGE_LOCAL__LISTEN_URL=http://127.0.0.1:9030

# Web 静态资源目录；为空时只提供 API，便于本地 Vite 开发；容器镜像常用 /opt/termbridge/web/dist。
# TERMBRIDGE_LOCAL__STATIC_DIR=

# 浏览器访问 agent 前端/setup 的地址，用于 local dashboard 与云端授权回跳。
# TERMBRIDGE_LOCAL__PUBLIC_URL=http://localhost:9030

# 跨域 API Origin allowlist。这里配置的是前端页面 Origin，不是 API Origin；多 Origin 使用逗号分隔；空值表示不开放跨域。
# TERMBRIDGE_LOCAL__CORS_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com

# 是否在 agent API 错误响应中暴露内部错误细节。
# 仅建议本地调试打开；生产保持 false。
# TERMBRIDGE_LOCAL__EXPOSE_ERRORS=false

# ==============================================================================
# Cloud
# ==============================================================================

# Cloud JWT 认证密钥。必须是 base64 编码的 32 字节随机 key，普通明文 secret 会被拒绝。
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# TERMBRIDGE_CLOUD__JWT__SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# TERMBRIDGE_CLOUD__JWT__TTL=24h

# Google OAuth
# TERMBRIDGE_CLOUD__GOOGLE__CLIENT_ID=
# TERMBRIDGE_CLOUD__GOOGLE__CLIENT_SECRET=
# TERMBRIDGE_CLOUD__GOOGLE__REDIRECT_URL=https://cloud.example.com/oauth2/google/callback

# GitHub OAuth App
# TERMBRIDGE_CLOUD__GITHUB__CLIENT_ID=
# TERMBRIDGE_CLOUD__GITHUB__CLIENT_SECRET=
# TERMBRIDGE_CLOUD__GITHUB__REDIRECT_URL=https://cloud.example.com/oauth2/github/callback

# Resend transactional email
# TERMBRIDGE_CLOUD__RESEND__API_KEY=
# TERMBRIDGE_CLOUD__RESEND__FROM_EMAIL=noreply@example.com

# termbridge cloud 暴露的云端后端 API 地址。
# TERMBRIDGE_CLOUD__LISTEN_URL=http://127.0.0.1:9030

# Web 静态资源目录；为空时只提供 API。
# TERMBRIDGE_CLOUD__STATIC_DIR=

# Cloud 对外访问地址，供浏览器页面、OAuth 授权跳转和帮助链接使用。
# TERMBRIDGE_CLOUD__PUBLIC_URL=https://cloud.example.com

# Agent 到 Cloud API 与 Tunnel 的服务间地址，必须显式配置。
# TERMBRIDGE_CLOUD__API_BASE_URL=https://cloud-api.example.com

# Cloudflare Turnstile protects public email/password login and registration.
# Set enabled to false to bypass the challenge.
# TERMBRIDGE_CLOUD__TURNSTILE__ENABLED=true
# TERMBRIDGE_CLOUD__TURNSTILE__SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
# TERMBRIDGE_CLOUD__TURNSTILE__SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# 跨域 API Origin allowlist；多 Origin 使用逗号分隔；空值表示不开放跨域。
# TERMBRIDGE_CLOUD__CORS_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com

# 是否在 cloud API 错误响应中暴露内部错误细节。
# 仅建议本地调试打开；生产保持 false。
# TERMBRIDGE_CLOUD__EXPOSE_ERRORS=false
# TERMBRIDGE_CLOUD__ADMIN__USER_IDS=
# TERMBRIDGE_CLOUD__ADMIN__EMAILS=admin@example.com

# Cloud OAuth2 client registry 使用 configs/config.<env>.yaml 配置为 cloud.oauth.clients[]，包含 client_secret。
# Agent 侧 OAuth2 client 配置使用 local.oauth.*，用于发起授权和后端换 token；client_secret 只给 Agent 后端使用，不注入浏览器。
# TERMBRIDGE_LOCAL__OAUTH__CLIENT_ID=termbridge-agent
# TERMBRIDGE_LOCAL__OAUTH__CLIENT_SECRET=agent-secret
# TERMBRIDGE_LOCAL__OAUTH__REDIRECT_URL=http://localhost:9030/oauth/callback
# TERMBRIDGE_LOCAL__OAUTH__SCOPES=openid,email,profile

# ==============================================================================
# Agent Database
# ==============================================================================

# Agent 独立数据库；开发默认 data/agent.db，打包默认 ~/.termbridge/agent.db。
# TERMBRIDGE_LOCAL__DATABASE__DRIVER=sqlite
# TERMBRIDGE_LOCAL__DATABASE__SQLITE__PATH=data/agent.db
# TERMBRIDGE_LOCAL__DATABASE__SQLITE__PATH=~/.termbridge/agent.db
# TERMBRIDGE_LOCAL__DATABASE__MYSQL__DSN=user:pass@tcp(127.0.0.1:3306)/termbridge?parseTime=true

# ==============================================================================
# Cloud Database
# ==============================================================================

# Cloud 独立数据库；configs/config.yaml 默认 sqlite:data/cloud.db。
# TERMBRIDGE_CLOUD__DATABASE__DRIVER=sqlite
# TERMBRIDGE_CLOUD__DATABASE__SQLITE__PATH=data/cloud.db
# TERMBRIDGE_CLOUD__DATABASE__MYSQL__DSN=user:pass@tcp(127.0.0.1:3306)/termbridge?parseTime=true

