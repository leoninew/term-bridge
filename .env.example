# TermBridge-go 环境变量示例
#
# 复制为项目根目录下的 .env 后生效；复制为 .env.<env> 后配合 OS env TERMBRIDGE_ENV=<env> 生效。
# 默认配置优先级：configs/config.yaml < .env < OS env。
# 设置 OS env TERMBRIDGE_ENV=<env> 后，优先级为：
# configs/config.yaml < configs/config.<env>.yaml < .env.<env> < OS env。
# TERMBRIDGE_ENV 只从 OS env 读取，不从 .env / .env.<env> 读取。
# .env / .env.<env> 不会覆盖 Docker/systemd/Kubernetes/CI/shell 已注入的同名环境变量。
# 启动自动生成的 jwt.secret_key 仍按配置层写入；设备身份生成在 runtime.state_dir/agent.json。
# 命名规则：TERMBRIDGE_ + 配置 key 大写，key 中的 . 转为 __。

# ==============================================================================
# JWT
# ==============================================================================

# JWT 认证密钥（必填）。必须是 base64 编码的 32 字节随机 key，普通明文 secret 会被拒绝。
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# TERMBRIDGE_JWT__SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ==============================================================================
# Log
# ==============================================================================

# TERMBRIDGE_LOG__LEVEL=info
# TERMBRIDGE_LOG__FORMAT=text
# TERMBRIDGE_LOG__DIR=logs
# TERMBRIDGE_LOG__HTTP__REQUEST_BODY_LIMIT=4096
# TERMBRIDGE_LOG__HTTP__RESPONSE_BODY_LIMIT=4096

# ==============================================================================
# History
# ==============================================================================

# TERMBRIDGE_HISTORY__MAX_LINES=10000
# TERMBRIDGE_HISTORY__MAX_BYTES=5242880
# TERMBRIDGE_HISTORY__MAX_LINE_BYTES=65536

# ==============================================================================
# Runtime
# ==============================================================================

# 本地默认：.termbridge；容器部署常用：/var/lib/termbridge。
# TERMBRIDGE_RUNTIME__STATE_DIR=.termbridge

# ==============================================================================
# Server
# ==============================================================================

# Web/runtime mode: local 为本机控制台；cloud 为云端门户。
# TERMBRIDGE_SERVER__MODE=local

# termbridge serve 暴露的后端 API 地址。本地默认 127.0.0.1:9030；容器部署常用 0.0.0.0:80。
# TERMBRIDGE_SERVER__LISTEN_URL=http://127.0.0.1:9030

# Web 静态资源目录；为空时只提供 API，便于本地 Vite 开发；容器镜像常用 /opt/termbridge/web/dist。
# TERMBRIDGE_SERVER__STATIC_DIR=

# 浏览器访问当前 server 前端/setup 的地址，用于 local dashboard 与云端授权回跳。
# TERMBRIDGE_SERVER__PUBLIC_URL=http://localhost:9031

# ==============================================================================
# Gate API
# ==============================================================================

# 是否在 API 错误响应中暴露内部错误细节。
# 仅建议本地调试打开；生产保持 false。
# TERMBRIDGE_GATE__API__EXPOSE_ERRORS=false

# ==============================================================================
# Cloud connection
# ==============================================================================

# 固定 Cloud Gate 的外部访问地址。
# 本地 /cloud/oauth/start 会按 OAuth2 client 配置跳转到该地址完成云端账号授权。
# TERMBRIDGE_CLOUD__GATE_URL=https://gate.example.com

# TermBridge Cloud OAuth2 client 配置。local mode 作为 Cloud Gate 的 OAuth2 client，
# redirect_url 指向本机 /cloud/oauth/callback。
# TERMBRIDGE_CLOUD__OAUTH__CLIENT_ID=termbridge-local
# TERMBRIDGE_CLOUD__OAUTH__CLIENT_SECRET=
# TERMBRIDGE_CLOUD__OAUTH__REDIRECT_URL=http://localhost:9031/cloud/oauth/callback
# TERMBRIDGE_CLOUD__OAUTH__SCOPES=openid,email,profile

# ==============================================================================
# Database
# ==============================================================================

# TERMBRIDGE_DATABASE__DRIVER=sqlite
# TERMBRIDGE_DATABASE__SQLITE__PATH=.termbridge/termbridge.db
# TERMBRIDGE_DATABASE__MYSQL__DSN=user:pass@tcp(127.0.0.1:3306)/termbridge?parseTime=true

# ==============================================================================
# Auth
# ==============================================================================

# TERMBRIDGE_AUTH__JWT_TTL=24h

# Local admin
# TERMBRIDGE_AUTH__LOCAL_ADMIN__USERNAME=admin
# TERMBRIDGE_AUTH__LOCAL_ADMIN__PASSWORD=admin

# Password policy
# TERMBRIDGE_AUTH__PASSWORD__MIN_LENGTH=8
# TERMBRIDGE_AUTH__PASSWORD__MAX_LENGTH=128

# Verification code
# TERMBRIDGE_AUTH__CODE__LENGTH=6
# TERMBRIDGE_AUTH__CODE__TTL=2m
# TERMBRIDGE_AUTH__CODE__RESEND_COOLDOWN=1m
# TERMBRIDGE_AUTH__CODE__MAX_ATTEMPTS=3

# Google OAuth
# TERMBRIDGE_AUTH__GOOGLE__CLIENT_ID=
# TERMBRIDGE_AUTH__GOOGLE__CLIENT_SECRET=
# TERMBRIDGE_AUTH__GOOGLE__REDIRECT_URL=https://gate.example.com/auth/google/callback

# ==============================================================================
# Resend
# ==============================================================================

# TERMBRIDGE_RESEND__API_KEY=
# TERMBRIDGE_RESEND__FROM_EMAIL=noreply@example.com
